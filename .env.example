# 🔐 PROJETO: CONFIGURAÇÃO DE AMBIENTE (.ENV.EXAMPLE)
# 🎯 Objetivo: Modelo de variáveis necessárias para rodar o projeto.
# ⚠️ INSTRUÇÃO: Copie este arquivo, renomeie para apenas ".env" e preencha os valores.
# 🛑 NUNCA compartilhe o seu arquivo ".env" final no GitHub.

# --- 1. SEGURANÇA DO DJANGO ---
# Gere uma chave aleatória para proteger a sessão e os dados do seu site.
SECRET_KEY=sua-chave-secreta-aqui

# Mantenha True para testar no seu computador e False para colocar na internet.
DEBUG=True

# --- 2. CONFIGURAÇÃO DE ACESSO ---
# Em desenvolvimento, use '*'. Em produção, use seu domínio (ex: ryanv.pythonanywhere.com).
# IMPORTANTE: No .env, não use colchetes ou aspas, apenas os valores separados por vírgula.
ALLOWED_HOSTS=*,127.0.0.1,localhost

# URL personalizada para o painel administrativo (ex: painel-secreto/)
ADMIN_URL=admin/

# --- 3. COMUNICAÇÃO (SMTP / GMAIL) ---
# O e-mail que enviará as mensagens do formulário de contato.
EMAIL_USER=seu-email@gmail.com

# Não é a sua senha comum! Use uma "Senha de App" gerada na sua conta Google.
EMAIL_PASS=sua-senha-de-app-de-16-digitos